NODE_ENV=development
API_PORT=3002
API_BASE_URL=http://localhost:3000

# Database (matches infra/docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=qc
DB_PASSWORD=qc_password_change_me
DB_DATABASE=qc_inspector

# JWT
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_another_long_random_string_at_least_32_chars
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=30d

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# MFA
MFA_ISSUER=QC Inspector
MFA_REQUIRED_FOR_ROLES=admin
