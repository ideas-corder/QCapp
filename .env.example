# Database
POSTGRES_DB=qc_inspector
POSTGRES_USER=qc
POSTGRES_PASSWORD=qc_password_change_me

# API
API_PORT=3002
API_BASE_URL=http://localhost:3002

# JWT
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_another_long_random_string_at_least_32_chars
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=30d

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Web
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3002
QC_ACCESS_COOKIE_MAX_AGE_SECONDS=43200
QC_REFRESH_COOKIE_MAX_AGE_SECONDS=2592000

# Flutter (read by --dart-define at build time)
API_URL=http://localhost:3000
